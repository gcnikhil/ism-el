# =============================================================================
# .gitignore for ism-el (ContextTier Engine)
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# --- Testing & Code Quality ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- Tooling and Runtime State ---
.streamlit/
logs/
*.log
tmp/
temp/

# --- LaTeX Intermediate Build Artifacts (Keep *.tex, *.bib, *.pdf, *.md) ---
*.aux
*.bbl
*.blg
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex
*.nav
*.snm
*.vrb
*.bcf
*.run.xml

# --- Datasets & Heavy Local Binary Caches ---
# CIFAR-10 source data and columnar caches exceed GitHub's 100 MB file limit.
cifar10_dataset/
*.arrow
*.npy
*.npz
*.bin
data/artifacts/*.npy
data/artifacts/*.npz
data/artifacts/*.bin
data/artifacts/**/*.bin
data/artifacts/hot_cache/
data/artifacts/train_chunks/
data/artifacts/validation_chunks/

# --- Secrets and Local Config ---
.env
.env.*
*.token
*.key
*.pem

# --- OS / Editor Metadata ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
